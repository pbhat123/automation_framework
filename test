def get_button_details_js(self):
    return self.actions.execute_javascript("""
    var buttons = document.querySelectorAll('button');
    var result = [];
    for(let i = 0; i < buttons.length; i++) {
        result.push(i + ': ' + buttons[i].textContent + ' | class: ' + buttons[i].className);
    }
    return result.join(' | ');
    """)
