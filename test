# ---------------- TIMESTAMPED HTML REPORT PER RUN ----------------
def _detect_app_name_from_items(items):
    """Looks at the collected test items' file paths to determine the app name."""
    app_names = set()
    for item in items:
        parts = str(item.fspath).replace("\\", "/").split("/")
        if "apps" in parts:
            idx = parts.index("apps")
            if idx + 1 < len(parts):
                app_names.add(parts[idx + 1])

    if len(app_names) == 1:
        return app_names.pop()
    elif len(app_names) > 1:
        return "multiple_apps"
    return "unknown_app"


def pytest_collection_modifyitems(config, items):
    if not config.option.htmlpath:
        timestamp = get_timestamp()
        app_name = _detect_app_name_from_items(items)

        report_dir = create_directory_if_not_exists(os.path.join("reports", app_name))
        config.option.htmlpath = os.path.join(report_dir, f"{timestamp}_{app_name}_test_report.html")
        config.option.self_contained_html = True
